    LTEXT           "Console", -1, 10, 199, 52, 10
    EDITTEXT        IDC_GUI_OUTPUT, 10, 211, 425, 143, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

